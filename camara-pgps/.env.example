# ---------------------------------------------------------------------------
# camara-pgps environment configuration
#
# Copy this file to `.env` and fill in the values you need. Every variable is
# optional: anything left unset falls back to `configs/config.yaml`, and then to
# the defaults baked into `camara_pgps.config`.
#
# Nested settings use a double-underscore delimiter, e.g. CAMARA_PGPS_LLM__MODEL
# maps to settings.llm.model.
# ---------------------------------------------------------------------------

# Point the loader at a non-default YAML file if desired.
# CAMARA_PGPS_CONFIG=configs/config.yaml

# Runtime
CAMARA_PGPS_ENVIRONMENT=development
CAMARA_PGPS_DEBUG=false
CAMARA_PGPS_LOG_LEVEL=INFO

# LLM provider
CAMARA_PGPS_LLM__PROVIDER=anthropic
CAMARA_PGPS_LLM__MODEL=claude-sonnet-5
CAMARA_PGPS_LLM__API_KEY=
# OPENAI_API_KEY / ANTHROPIC_API_KEY are also read directly by the provider SDKs.
ANTHROPIC_API_KEY=

# Embeddings ("sentence-transformers" or "hash" for an offline deterministic backend)
CAMARA_PGPS_EMBEDDING__PROVIDER=sentence-transformers
CAMARA_PGPS_EMBEDDING__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CAMARA_PGPS_EMBEDDING__DEVICE=cpu
CAMARA_PGPS_EMBEDDING__BATCH_SIZE=32

# Vector store (ChromaDB)
CAMARA_PGPS_VECTOR_STORE__PERSIST_DIRECTORY=data/chroma
CAMARA_PGPS_VECTOR_STORE__COLLECTION_NAME=camara_specs
CAMARA_PGPS_VECTOR_STORE__DISTANCE=cosine

# Knowledge graph
CAMARA_PGPS_GRAPH__PATH=data/knowledge_graph.gml

# Local CAMARA API registry (authoritative source of executable APIs)
CAMARA_PGPS_REGISTRY__PATH=data/registry/camara_apis.json

# CAMARA API target (real gateway or the bundled mock)
CAMARA_PGPS_CAMARA__BASE_URL=http://localhost:8080
CAMARA_PGPS_CAMARA__TOKEN=
CAMARA_PGPS_CAMARA__TIMEOUT_SECONDS=30.0

# Execution layer: how validated plans are run (mock | rest | mcp)
CAMARA_PGPS_EXECUTION__MODE=mock
CAMARA_PGPS_EXECUTION__STOP_ON_ERROR=true
CAMARA_PGPS_EXECUTION__DRY_RUN=false

# Bundled mock CAMARA server
CAMARA_PGPS_MOCK_CAMARA__HOST=0.0.0.0
CAMARA_PGPS_MOCK_CAMARA__PORT=8080

# Application API server
CAMARA_PGPS_SERVER__HOST=0.0.0.0
CAMARA_PGPS_SERVER__PORT=8000
CAMARA_PGPS_SERVER__RELOAD=false

# Model Context Protocol
CAMARA_PGPS_MCP__ENABLED=false
